# Copy to .env.local (gitignored) and fill in from
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# These are PUBLIC client identifiers, not server secrets. Never commit service-account keys
# or App Check debug tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (required for Firebase AI Logic).
# Provider: "recaptcha-enterprise" (recommended) or "recaptcha-v3".
VITE_APPCHECK_PROVIDER=recaptcha-enterprise
# Public reCAPTCHA site key registered for your hosting domain(s).
VITE_APPCHECK_SITE_KEY=

# DEVELOPMENT ONLY — put this in .env.local, never in a committed file.
# Register the token under Firebase console → App Check → Apps → Manage debug tokens.
# It is ignored in production builds.
# VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud fallback model (defaults to the documented hybrid default).
# VITE_AI_CLOUD_MODEL=gemini-3.5-flash-lite

# --- v0.5 release configuration ---
# Guardian consent backend (Cloud Functions in /functions, needs the Blaze plan + Trigger Email extension).
# Leave empty until it is deployed; children then stay in local-only mode.
VITE_CONSENT_FUNCTIONS=
# Operator (data controller) shown in the privacy policy and terms. Never invent these.
# The contact email defaults to the project owner's address when left empty.
VITE_OPERATOR_NAME=
VITE_OPERATOR_EMAIL=
VITE_OPERATOR_ADDRESS=
